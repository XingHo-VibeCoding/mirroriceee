# ============================================
# .env.example —— 环境变量「模板」（这个文件要进 Git，给同学看）
# ============================================
# 怎么用这个文件：
#   1. 复制一份，改名为 .env      （cp .env.example .env）
#   2. 把下面的「占位值」换成你自己的真实值
#   3. .env 已被 .gitignore 挡住，永远不会被提交
#
# 铁律：真值只写进 .env，绝不写进本文件、绝不写进代码、绝不截图发群。

# --- 数据库（CloudBase PostgreSQL）---
# 说明：本项目当前【不用】PGHOST/PGPASSWORD 直连 —— 免费体验版没有内网地址、
#       角色也全是 NOLOGIN（原因详见 cloudfunctions/echoread-api/lib/rdb.js 顶部注释）。
#       改成调 PG REST 网关，只需要下面这一把 Key。
# 下面三行保留作「将来若换直连方案」的占位，当前未启用：
# PGHOST=your-db-host
# PGUSER=your-db-user
# PGPASSWORD=your-db-password

# --- CloudBase 云函数环境变量 ---
# CLOUDBASE_API_KEY：调 PG REST 网关用的 Key（等于数据库万能钥匙，只放在云函数环境变量里）
CLOUDBASE_API_KEY=your_cloudbase_api_key_here

# CLOUDBASE_ENV_ID：CloudBase 环境 ID（不是秘密，公网地址里就带；可不填，代码有默认值）
CLOUDBASE_ENV_ID=your-env-id

# --- 本地开发服务器（可选）---
# 端口不填默认 8000
# PORT=8000

# ============================================
# AI 对话（Day 32）：语音转写 + AI 批改
# ============================================
# 这两组 Key 缺任何一组，页面上那条灰条就会明说缺哪个变量，
# 不会装成"能用"。填完重启 node dev-server.js 生效。

# --- 腾讯云（语音识别）---
# 去哪拿：腾讯云控制台 → 访问管理 → API 密钥管理 → 新建密钥
# ⚠️ 还要另外去「语音识别」控制台【开通「一句话识别」】，
#    只建了密钥但没开通服务，调用会报 FailedOperation 而不是签名错误。
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here

# 识别引擎（不填默认 16k_en）：
#   16k_en    英语（本项目默认，学生练英文）
#   16k_zh    中文
#   16k_zh_en 中英混合（学生英文里常夹中文时更稳，但英文准确度略降）
# ASR_ENGINE=16k_en

# --- DeepSeek（AI 批改）---
# 去哪拿：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 模型（不填默认 deepseek-chat）
# 为什么不用 reasoner：批改要的是"快 + 稳"，推理模型首字延迟高好几秒，
# 学生对着空白气泡等 10 秒，体验比偶尔改错一句还差。
# DEEPSEEK_MODEL=deepseek-chat
